{
  "root": true,
  "extends": ["react-app"],
  "plugins": [
    "@stylistic",
    "import-newlines"
  ],
  "rules": {
    "@stylistic/quotes": [
      "error",
      "single",
      {
        "avoidEscape": true
      }
    ],
    "@stylistic/object-curly-newline": [
      "error",
      {
        "ImportDeclaration": {
          "minProperties": 2
        }
      }
    ]
  }
}
