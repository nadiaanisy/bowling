
{
  "root": true,
  "extends": ["react-app"],
  "plugins": [
    "@stylistic",
    "import-newlines"
  ],
  "rules": {
    "@stylistic/quotes": [
      "error",
      "single",
      {
        "avoidEscape": true
      }
    ],
    "@stylistic/indent": [
      "error",
      2
    ],
    "@stylistic/object-curly-newline": [
      "error",
      {
        "ImportDeclaration": {
          "minProperties": 2
        }
      }
    ],
    "import-newlines/enforce": [
      "error",
      {
        "items": 1,
        "max-len": 80,
        "semi": true
      }
    ]
  }
}
